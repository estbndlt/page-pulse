# Copy to .env locally. Never commit real values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=postgres

JWT_SECRET=replace-with-at-least-32-random-characters
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt

API_EXTERNAL_URL=https://api.example.com
SITE_URL=pagepulse://auth/callback
ADDITIONAL_REDIRECT_URLS=pagepulse://auth/callback,http://localhost:3000

GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SECRET=replace-with-google-oauth-client-secret

CLOUDFLARED_TOKEN=replace-with-cloudflare-tunnel-token
